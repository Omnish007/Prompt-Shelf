{
  "name": "prompt-shelf",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "electron .",
    "electron:rebuild": "electron-builder install-app-deps",
    "package:dir": "npm run build && electron-builder --linux dir",
    "package:linux": "npm run build && electron-builder --linux deb AppImage",
    "package:deb": "npm run build && electron-builder --linux deb",
    "theme:contrast": "node scripts/check-theme-contrast.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "version": "1.0.0",
  "description": "A local-first prompt library for web and Ubuntu desktop.",
  "homepage": "https://github.com/Omnish007/Prompt-Shelf",
  "main": "electron/main.cjs",
  "author": "PromptShelf <support@promptshelf.dev>",
  "desktopName": "prompt-shelf.desktop",
  "build": {
    "appId": "dev.promptshelf.desktop",
    "productName": "PromptShelf",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "docs/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "PromptShelf <support@promptshelf.dev>",
      "syncDesktopName": true,
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "synopsis": "A local-first prompt library",
      "description": "Save, organize, search, template, and back up AI prompts locally."
    }
  }
}